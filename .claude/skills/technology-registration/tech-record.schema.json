{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technology.v1.schema.json",
  "title": "Technology record schema",
  "description": "Representing technology record in the repository",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier of the technology",
      "pattern": "^[0-9a-fA-F]{8}$"
    },
    "name": {
      "type": "string",
      "description": "Name of the technology"
    },
    "aliases": {
      "type": "array",
      "description": "List of different aliases for this technology",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "$ref": "#/$defs/state",
      "description": "Represents the current lifecycle stage or classification of the technology within the organization. Purpose is to indicates the organization's stance on the technology, and to guide decision-making for usage, procurement, or phasing out."
    },
    "direction": {
      "$ref": "#/$defs/state",
      "description": "Indicates the organization's planned or recommended course of action regarding the technology. Purpose is to provide strategic guidance and decision-making for future usage, procurement, phasing out or avoid a technology."
    },
    "description": {
      "type": "string",
      "description": "Description of the technology"
    },
    "capabilities": {
      "type": "array",
      "description": "List of main capabilities of the technology, including security (authN, authZ, encryption, IAM, SSO), audit log, compliance features (regulatory, legal, privacy), interoperability and integration (APIs, interfaces), data protection (integrity controls, auditability, data classification), observability (logging, monitoring, alerting)",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "description": "Comment about the capability"
          }
        }
      }
    },
    "use-cases": {
      "type": "array",
      "description": "List of use cases where/how the technology is used.",
      "items": {
        "type": "string"
      }
    },
    "versions": {
      "type": "array",
      "description": "List of version information of the technology",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "Version number or identifier of the technology version"
          },
          "description": {
            "type": "string",
            "description": "Description of the technology version"
          },
          "releaseDate": {
            "type": "string",
            "format": "date",
            "description": "The release date of the version"
          },
          "endOfLifeDate": {
            "type": "string",
            "format": "date",
            "description": "The end of life date of the version"
          },
          "status": {
            "description": "The current lifecycle status of the technology version.",
            "anyOf": [
              {
                "const": "pre-alpha",
                "description": "Early development, unstable, internal testing only."
              },
              {
                "const": "alpha",
                "description": "Initial testing phase, unstable, limited to internal users."
              },
              {
                "const": "beta",
                "description": "More stable, available to external testers, feature-complete but may have bugs."
              },
              {
                "const": "release-candidate",
                "description": "Final testing phase before official release, nearly production-ready."
              },
              {
                "const": "general-availability",
                "description": "Official stable release, production-ready, fully supported."
              },
              {
                "const": "active-support",
                "description": "Regular updates, bug fixes, and new features."
              },
              {
                "const": "security-only-updates",
                "description": "Only critical security patches, no new features."
              },
              {
                "const": "deprecated",
                "description": "No new features, but still functional; users encouraged to upgrade."
              },
              {
                "const": "end-of-life",
                "description": "No updates or support, considered obsolete."
              },
              {
                "const": "long-term-support",
                "description": "Maintained for an extended period, usually for stability-critical use cases."
              },
              {
                "const": "extended-support",
                "description": "Paid or enterprise-only support after EOL for critical patches."
              },
              {
                "const": "obsolete",
                "description": "No longer functional due to dependency or platform changes."
              },
              {
                "const": "archived",
                "description": "No longer available for use or distribution."
              }
            ]
          }
        },
        "required": [
          "version"
        ]
      }
    },
    "references": {
      "type": "array",
      "description": "List of references with URLs and comments",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The URL of the reference"
          },
          "identifier": {
            "type": "string",
            "description": "Identifier of the reference"
          },
          "comment": {
            "type": "string",
            "description": "Comment about the reference"
          }
        },
        "required": [
          "url",
          "identifier"
        ]
      }
    },
    "categories": {
      "type": "array",
      "description": "List of categories that this technology belongs to",
      "items": {
        "$ref": "#/$defs/categoryType"
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "description": "Category of the license.",
          "$ref": "#/$defs/licenseCategory"
        },
        "metric": {
          "type": "string",
          "description": "Metric on how the license is measured (e.g., number of users, processors, devices)."
        },
        "StartDate": {
          "type": "string",
          "format": "date",
          "description": "The start date of the license when it was obtained."
        },
        "ExpirationDate": {
          "type": "string",
          "format": "date",
          "description": "The expiration date of the license."
        },
        "RenewalTerms": {
          "type": "string",
          "description": "The terms for renewing the license."
        },
        "Restrictions": {
          "type": "string",
          "description": "Any restrictions or limitations associated with the license."
        }
      },
      "required": [
        "category",
        "metric"
      ],
      "additionalProperties": false
    },
    "vendor": {
      "type": "object",
      "description": "Vendor information for the technology",
      "properties": {
        "ref": {
          "type": "string",
          "format": "uri-reference",
          "description": "URI to the vendor's record"
        },
        "comment": {
          "type": "string",
          "description": "Comment about the vendor"
        }
      },
      "required": [
        "$ref"
      ]
    },
    "tags": {
      "type": "array",
      "description": "List of tags associated with the technology",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "description": "Type of the tag",
            "$ref": "#/$defs/tag-const"
          },
          "value": {
            "type": "string",
            "description": "Value relevant to the tag"
          },
          "comment": {
            "type": "string",
            "description": "Comment about the tag"
          }
        },
        "required": [
          "tag"
        ]
      }
    },
    "provisioning": {
      "type": "array",
      "description": "To capture provisioning of the same technology in different locations or by different teams",
      "items": {
        "type": "object",
        "identifier": {
          "type": "string",
          "description": "Unique identifier of provisioning of this technology."
        },
        "environments": {
          "type": "array",
          "description": "List of environments where the technology is provisioned",
          "items": {
            "type": "object",
            "properties": {
              "environment:": {
                "description": "Environment where the technology is provisioned",
                "anyOf": [
                  {
                    "const": "Development",
                    "description": "Development environment"
                  },
                  {
                    "const": "Testing",
                    "description": "Testing environment"
                  },
                  {
                    "const": "Acceptance/Staging",
                    "description": "Staging environment"
                  },
                  {
                    "const": "Production",
                    "description": "Production environment"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "URL of the environment"
              },
              "comment": {
                "type": "string",
                "description": "Comment about the environment"
              }
            }
          }
        },
        "ownership": {
          "type": "string",
          "description": "Ownership or contact(s) for the provisioning (location, team)"
        },
        "justification": {
          "type": "string",
          "description": "Elaborative reason for this provisioning."
        },
        "location": {
          "type": "string",
          "description": "Location of the provisioning (e.g. cloud provider, data center"
        },
        "deviations": {
          "type": "string",
          "description": "Any deviations from the standard provisioning"
        },
        "properties": {
          "comment": {
            "type": "string",
            "description": "Comment about the provisioning"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "description": "List of links related to the technology",
      "items": {
        "$ref": "#/$defs/linkItem"
      }
    },
    "exit_plan": {
      "type": "string",
      "description": "Description of the exit plan for the technology"
    }
  },
  "required": [
    "name",
    "status"
  ],
  "$defs": {
    "state": {
      "type": "object",
      "description": "Shared structure for status and direction state of the technology",
      "properties": {
        "value": {
          "description": "Technology status or direction value.",
          "anyOf": [
            {
              "const": "Backlog",
              "description": "Keep track of the backlog item that were submitted."
            },
            {
              "const": "As-Is",
              "description": "Identified currently used technology for which verification needs to be done.",
              "controls": [
                "There is an existing long-term team and/or department to support this technology."
              ]
            },
            {
              "const": "Candidate",
              "description": "Identified technology as a probable future standard",
              "controls": [
                "Not OK (NOK) study for purchase & projects monitored by Architecture Committee and Domains.",
                "There is an existing long term team and/or department to support this technology."
              ]
            },
            {
              "const": "Standard",
              "description": "Architecture Committee validated standard (sustainable) and to be used for all projects and remediations."
            },
            {
              "const": "Restricted",
              "description": "Architecture Committee validated standard ONLY **for restricted use case and/or scope if the global standard is not unfit or inadequate**.",
              "controls": [
                "Use of restricted standard needs approbation & justification matching the defined use case and scope.",
                "Restricted to be used only be central, or certain local entity, team or product."
              ],
              "example": "We are using Oracle DB ONLY for XXX busines criticall app."
            },
            {
              "const": "Deprecated",
              "description": "Indicates that a technology, feature, or component is no longer available or supported.",
              "action": "Transition to alternatives soon.",
              "example": "Java 8 is deprecated, and we are planning to upgrade to Java 11.",
              "controls": [
                "Purchases and license extensions will be challenged",
                "3 to 5 years after the deprecation, the tech will be purged into the Retired status"
              ]
            },
            {
              "const": "Retired",
              "description": "Technology, feature, or component is no longer available or supported. Marks the end of the lifecycle for a technology.",
              "action": "Must have already transition to alternatives.",
              "example": "We have retired the use of Java 8 and have upgraded to Java 11."
            },
            {
              "const": "Rejected",
              "description": "Listed technology is rejected and not allowed to be used."
            }
          ]
        },
        "conditions": {
          "oneOf": [
            {
              "type": "array",
              "description": "List of conditions that must be met for the status or direction to be valid, based on given controls.",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string",
              "description": "Textual description of conditions that must be met for the status or direction to be valid."
            }
          ]
        },
        "scope": {
          "type": "object",
          "description": "Defines the applicability boundary of the technology status or direction.",
          "properties": {
            "value": {
              "type": "string",
              "description": "The scope value indicating where the technology status/direction applies.",
              "oneOf": [
                {
                  "const": "group",
                  "description": "Applies across the entire organization group or conglomerate"
                },
                {
                  "const": "global",
                  "description": "Applies to the entire company globally"
                },
                {
                  "const": "central",
                  "description": "Applies to central IT or core services only"
                },
                {
                  "const": "local",
                  "description": "Restricted to specific regional offices or business units"
                },
                {
                  "const": "product",
                  "description": "Limited to specific product lines or applications"
                },
                {
                  "const": "platform",
                  "description": "Applies to a specific platform(s) or ecosystem"
                },
                {
                  "const": "application",
                  "description": "Applies to a specific application(s)"
                }
              ]
            },
            "comment": {
              "type": "string",
              "description": "Additional information about the scope"
            }
          },
          "required": [
            "value"
          ]
        },
        "effective": {
          "description": "Date from which this scope is active",
          "oneOf": [
            {
              "type": "string",
              "description": "Year only",
              "pattern": "^[0-9]{4}$"
            },
            {
              "type": "string",
              "description": "Year and month",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            {
              "type": "string",
              "format": "date",
              "description": "Full date in ISO 8601 format: YYYY-MM-DD"
            }
          ],
          "comment": {
            "type": "string",
            "description": "Comment about the state"
          }
        },
        "expiration": {
          "description": "Date until which the status is valid",
          "oneOf": [
            {
              "type": "string",
              "description": "Year only",
              "pattern": "^[0-9]{4}$"
            },
            {
              "type": "string",
              "description": "Year and month",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            {
              "type": "string",
              "format": "date",
              "description": "Full date in ISO 8601 format: YYYY-MM-DD"
            }
          ]
        },
        "required": [
          "value"
        ]
      }
    },
    "licenseCategory": {
      "anyOf": [
        {
          "const": "perpetual",
          "description": "LicensePerpetual"
        },
        {
          "const": "subscription",
          "description": "LicenseSubscription"
        },
        {
          "const": "usage-based",
          "description": "LicenseUsageBased"
        },
        {
          "const": "open source software",
          "description": "LicenseOSS",
          "open-source": true
        },
        {
          "const": "MIT License",
          "description": "LicenseMIT",
          "open-source": true
        },
        {
          "const": "Apache License",
          "description": "LicenseApache",
          "open-source": true
        },
        {
          "const": "GNU General Public License (GPL)",
          "description": "LicenseGPL",
          "open-source": true
        }
      ]
    },
    "tag-const": {
      "anyOf": [
        {
          "const": "sg-greenbook-ref",
          "description": "SG Greenbook Reference"
        },
        {
          "const": "leanix-ref",
          "description": "LeanIX Reference"
        },
        {
          "const": "greenbook",
          "description": "Greenbook"
        },
        {
          "const": "tech-radar",
          "description": "Indicatates that tagges technology is part of the Tech Radar"
        },
        {
          "const": "domain",
          "description": "define which domain will be responsible for the technology and it's support"
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        }
      ]
    },
    "categoryType": {
      "anyOf": [
        {
          "const": "Infrastructure"
        },
        {
          "const": "Hardware",
          "description": "Servers, storage devices, networking equipment.",
          "group": "Infrastructure"
        },
        {
          "const": "Networking",
          "description": "LAN, WAN, VPN, firewalls, routers, switches.",
          "group": "Infrastructure"
        },
        {
          "const": "Data Centers",
          "description": "On-premises, cloud-based, hybrid.",
          "group": "Infrastructure"
        },
        {
          "const": "Software"
        },
        {
          "const": "Operating Systems",
          "description": "Windows, Linux, macOS.",
          "group": "Software"
        },
        {
          "const": "Database Management Systems",
          "description": "SQL, NoSQL, Oracle, MySQL.",
          "group": "Software"
        },
        {
          "const": "Middleware",
          "description": "Integration software, message brokers, application servers.",
          "group": "Software"
        },
        {
          "const": "Applications"
        },
        {
          "const": "Enterprise Applications",
          "description": "ERP, CRM, SCM, HRM.",
          "group": "Applications"
        },
        {
          "const": "Productivity Software",
          "description": "Office suites, collaboration tools.",
          "group": "Applications"
        },
        {
          "const": "Custom Applications",
          "description": "In-house developed software, bespoke solutions.",
          "group": "Applications"
        },
        {
          "const": "Cloud Services"
        },
        {
          "const": "Infrastructure as a Service (IaaS)",
          "description": "AWS, Azure, Google Cloud.",
          "group": "Cloud Services"
        },
        {
          "const": "Platform as a Service (PaaS)",
          "description": "Heroku, Microsoft Azure.",
          "group": "Cloud Services"
        },
        {
          "const": "Software as a Service (SaaS)",
          "description": "Salesforce, Office 365, Google Workspace.",
          "group": "Cloud Services"
        },
        {
          "const": "Security",
          "description": "Technologies, tools, and solutions focused on protecting systems, networks, data, and users from cyber threats, unauthorized access, and ensuring compliance with security standards and regulations."
        },
        {
          "const": "Cybersecurity",
          "description": "Antivirus, anti-malware, intrusion detection systems.",
          "group": "Security"
        },
        {
          "const": "Identity and Access Management (IAM)",
          "description": "Single sign-on, multi-factor authentication.",
          "group": "Security"
        },
        {
          "const": "Data Protection",
          "description": "Encryption, backup solutions, DLP (Data Loss Prevention).",
          "group": "Security"
        },
        {
          "const": "Data Management"
        },
        {
          "const": "Big Data",
          "description": "Hadoop, Spark, data lakes.",
          "group": "Data Management"
        },
        {
          "const": "Business Intelligence (BI) and Analytics",
          "description": "Tableau, Power BI, SAS.",
          "group": "Data Management"
        },
        {
          "const": "Data Warehousing",
          "description": "Redshift, Snowflake, Teradata.",
          "group": "Data Management"
        },
        {
          "const": "Development and Operations (DevOps)",
          "description": "Tools, practices, and methodologies that combine software development (Dev) and IT operations (Ops) to shorten development lifecycle and provide continuous delivery with high quality."
        },
        {
          "const": "Development Tools",
          "description": "IDEs, code repositories (GitHub, GitLab).",
          "group": "Development and Operations (DevOps)"
        },
        {
          "const": "Continuous Integration/Continuous Deployment (CI/CD)",
          "description": "GitHub Actions, Azure DevOps, GitLab CI/CD",
          "group": "Development and Operations (DevOps)"
        },
        {
          "const": "Containerization and Orchestration",
          "description": "Docker, Kubernetes.",
          "group": "Development and Operations (DevOps)"
        },
        {
          "const": "User Interfaces and Experience"
        },
        {
          "const": "Front-end Technologies",
          "description": "HTML, CSS, JavaScript frameworks (React, Angular).",
          "group": "User Interfaces and Experience"
        },
        {
          "const": "Mobile Development",
          "description": "iOS, Android, cross-platform frameworks (Flutter, Xamarin).",
          "group": "User Interfaces and Experience"
        },
        {
          "const": "Emerging Technologies"
        },
        {
          "const": "Artificial Intelligence and Machine Learning",
          "description": "TensorFlow, PyTorch.",
          "group": "Emerging Technologies"
        },
        {
          "const": "Internet of Things (IoT)",
          "description": "IoT platforms, sensors, edge computing.",
          "group": "Emerging Technologies"
        },
        {
          "const": "Blockchain",
          "description": "Distributed ledgers, smart contracts.",
          "group": "Emerging Technologies"
        },
        {
          "const": "IT Service Management (ITSM)"
        },
        {
          "const": "ITSM Tools",
          "description": "ServiceNow, BMC Remedy.",
          "group": "IT Service Management (ITSM)"
        },
        {
          "const": "Incident and Problem Management",
          "description": "Ticketing systems, root cause analysis tools.",
          "group": "IT Service Management (ITSM)"
        }
      ]
    },
    "linkItem": {
      "type": "object",
      "properties": {
        "link": {
          "type": "string",
          "description": "Direction of the link",
          "anyOf": [
            {
              "const": "ProvidedBy",
              "description": "ProvidedBy specify who is offering the linked resource"
            },
            {
              "const": "DevelopedBy",
              "description": "specify who made this technology"
            },
            {
              "const": "UsedBy",
              "description": "Specify who is using the linked resource"
            },
            {
              "const": "ReplacedBy",
              "description": "Specify with what this resource is replaced by"
            },
            {
              "const": "Using",
              "description": "Specify what is used by the linked resource"
            }
          ]
        },
        "target": {
          "type": "string",
          "description": "Target record of the link",
          "format": "uri-reference",
          "isReference": true
        },
        "comment": {
          "type": "string",
          "description": "Comment about the link"
        },
        "tags": {
          "type": "array",
          "description": "List of tags associated with the link",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string",
                "description": "Type of the tag"
              },
              "value": {
                "type": "string",
                "description": "Value relevant to the tag"
              },
              "comment": {
                "type": "string",
                "description": "Comment about the tag"
              }
            },
            "required": [
              "tag"
            ]
          }
        },
        "t2": {
          "type": "object"
        }
      },
      "required": [
        "link",
        "target"
      ]
    }
  }
}
