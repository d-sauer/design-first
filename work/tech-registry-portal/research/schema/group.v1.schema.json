{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "group.v1.schema.json",
  "title": "Group schema",
  "description": "Group schema to define logical collections or categories of related repository items.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier of the group",
      "pattern": "^[0-9a-fA-F]{8}$"
    },
    "name": {
      "type": "string",
      "description": "Name of the group"
    },
    "aliases": {
      "type": "array",
      "description": "List of different aliases for this group",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    }
  },
  "required": ["id, name"],
  "$defs": {
  }
}
